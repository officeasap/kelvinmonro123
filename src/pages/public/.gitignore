# Dependencies
node_modules/

# Build output
dist/
build/
.vite/
.cache/

# Environment / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime / temporary files
tmp/
temp/
*.tmp

# Coverage
coverage/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

.idea/
*.swp
*.swo

# TypeScript build cache
*.tsbuildinfo

# Local development artifacts
*.local

# Vercel local configuration
.vercel/

# Miscellaneous generated files
*.bak
*.orig

